---
import { useTranslations, type Lang } from '../i18n/ui';
import { links } from '../data/links';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="contact reveal" id="contact">
  <div class="sec-head"><h2>{t('contact.title')}</h2><span class="meta">{t('contact.meta')}</span></div>
  <p>{t('contact.body')}</p>
  <a class="mail" href={`mailto:${links.email}`}>{links.email}</a>
  <div class="socials">
    <a href={links.github} target="_blank" rel="noopener noreferrer">github ↗</a>
    <a href={links.linkedin} target="_blank" rel="noopener noreferrer">linkedin ↗</a>
    <a href={links.whatsapp} target="_blank" rel="noopener noreferrer">whatsapp ↗</a>
  </div>
</section>
<style>
  .contact p { color: var(--muted); font-size: 1.12rem; max-width: 52ch; margin-bottom: 2rem; }
  .mail {
    font-size: clamp(1.4rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.02em;
    color: var(--text); text-decoration: none; position: relative; display: inline-block;
  }
  .mail::after {
    content: ""; position: absolute; left: 0; right: 100%; bottom: -6px; height: 4px;
    background: var(--coral); border-radius: 3px; transition: right 0.4s var(--ease);
  }
  .mail:hover::after { right: 0; }
  .socials { margin-top: 2.2rem; display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .socials a {
    font-family: var(--mono); font-size: 0.85rem; color: var(--muted); text-decoration: none;
    border: 1px solid var(--border); border-radius: 99px; padding: 0.5rem 1.1rem;
    transition: transform 0.3s var(--ease-pop), background 0.3s var(--ease), color 0.3s var(--ease), box-shadow 0.3s var(--ease-pop);
  }
  .socials a:nth-child(1):hover { background: var(--mint); color: var(--bg); transform: rotate(-2deg) translateY(-2px); box-shadow: 3px 3px 0 oklch(0.42 0.07 160); }
  .socials a:nth-child(2):hover { background: var(--butter); color: var(--bg); transform: rotate(2deg) translateY(-2px); box-shadow: 3px 3px 0 oklch(0.45 0.06 95); }
  .socials a:nth-child(3):hover { background: var(--coral); color: #fff; transform: rotate(-1.5deg) translateY(-2px); box-shadow: 3px 3px 0 oklch(0.35 0.1 45); }
</style>

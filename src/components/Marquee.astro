---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const items = useTranslations(lang)('marquee.items').split('|');
---
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => items.map((item) => <span>{item} <b>✦</b></span>))}
  </div>
</div>
<style>
  .marquee {
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    overflow: hidden; padding: 0.75rem 0; background: var(--surface);
    transform: rotate(-1deg) scale(1.02); margin: 1.5rem 0 0.5rem;
  }
  .marquee-track { display: flex; gap: 2.5rem; width: max-content; animation: scroll-x 22s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee span { font-family: var(--mono); font-weight: 600; font-size: 0.9rem; white-space: nowrap; color: var(--muted); }
  .marquee span b { color: var(--coral); }
  .marquee span:nth-child(odd) b { color: var(--butter); }
</style>

---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import yo from '../assets/yo.jpeg';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="about reveal" id="about">
  <div class="sec-head"><h2>{t('about.title')}</h2><span class="meta">{t('about.meta')}</span></div>
  <div class="about-grid">
    <Image class="about-photo" src={yo} alt="Kevin David Lopez Verdin" width={480} />
    <p><strong>{t('about.body.strong')}</strong> {t('about.body.rest')} <strong>{t('about.body.strong2')}</strong>.</p>
  </div>
</section>
<style>
  section.about { border-top: 0; }
  .about-grid { display: grid; grid-template-columns: 230px 1fr; gap: 2.2rem; align-items: start; }
  .about-photo {
    width: 100%; height: auto;
    aspect-ratio: 1 / 1.05;
    object-fit: cover; object-position: top;
    border-radius: 18px 18px 0 0;
    mask-image: linear-gradient(to bottom, black 45%, transparent 96%);
    -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 96%);
  }
  @media (max-width: 700px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { max-width: 230px; }
  }
  .about p { color: var(--muted); font-size: 1.12rem; max-width: 62ch; }
  .about strong { color: var(--text); }
  .about a { color: var(--mint); text-decoration: none; }
  :global(.js .reveal .about-photo) { opacity: 0; transform: translateX(-26px); transition: opacity 0.8s var(--ease) 0.15s, transform 0.8s var(--ease) 0.15s; }
  :global(.js .reveal.in .about-photo) { opacity: 1; transform: none; }
  :global(.js .reveal .about-grid p) { opacity: 0; transform: translateY(18px); transition: opacity 0.8s var(--ease) 0.35s, transform 0.8s var(--ease) 0.35s; }
  :global(.js .reveal.in .about-grid p) { opacity: 1; transform: none; }
</style>

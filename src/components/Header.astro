---
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
---
<header>
  <div class="wrap header-in">
    <a class="logo" href={localizePath(lang)} data-egg-msg={t('egg.msg')}>kevindlv</a>
    <nav>
      <a href="#about">{t('nav.about')}</a>
      <a href="#skills">{t('nav.stack')}</a>
      <a href="#work">{t('nav.work')}</a>
      <a href="#process">{t('nav.process')}</a>
      <a href="#contact">{t('nav.contact')}</a>
      <a class="lang" href={localizePath(otherLang)} data-lang-switch aria-label={`${lang.toUpperCase()}/${otherLang.toUpperCase()}: ${otherLang === 'es' ? 'Cambiar a español' : 'Switch to English'}`}>
        <b>{lang.toUpperCase()}</b><i>{otherLang.toUpperCase()}</i>
      </a>
    </nav>
  </div>
</header>
<style>
  header {
    position: sticky; top: 0; z-index: 30;
    background: oklch(0.14 0.015 160 / 0.9);
    border-bottom: 1px solid var(--border);
  }
  .header-in { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; }
  .logo {
    font-weight: 800; font-size: 1.05rem; text-decoration: none;
    background: var(--butter); color: var(--bg); padding: 0.15rem 0.6rem; border-radius: 7px;
    transform: rotate(-2deg); display: inline-block; transition: transform 0.3s var(--ease-pop);
  }
  .logo:hover { transform: rotate(2deg) scale(1.05); }
  nav { display: flex; gap: 1.6rem; align-items: center; }
  nav > a { color: var(--muted); text-decoration: none; font-family: var(--mono); font-size: 0.82rem; transition: color 0.25s var(--ease); }
  nav > a:hover { color: var(--mint); }
  .lang { font-family: var(--mono); font-size: 0.78rem; border: 1px solid var(--border); border-radius: 8px; padding: 0.25rem 0.3rem; display: flex; gap: 0.15rem; cursor: pointer; text-decoration: none; }
  .lang b { background: var(--text); color: var(--bg); border-radius: 5px; padding: 0.05rem 0.5rem; }
  .lang i { font-style: normal; padding: 0.05rem 0.5rem; color: var(--muted); }

  @media (max-width: 640px) {
    nav { gap: 1rem; }
    nav > a:not(.lang) { display: none; }
  }
</style>
<style is:global>
  /* egg v2 "derrumbe y renacer": .egg-msg is created dynamically by Header's
     script (reduced-motion fallback only), so it never receives Astro's
     scoped data-attribute — must stay global (Task 6 lesson: scoped styles
     don't reach JS-created nodes). The collapse/rebirth itself animates real
     page elements in place via WAAPI, so it needs no extra CSS at all. */
  .egg-msg {
    position: fixed; top: 50%; left: 50%;
    translate: -50% -50%; rotate: -2deg;
    background: var(--butter); color: var(--bg);
    font-weight: 800; font-size: clamp(1.05rem, 3vw, 1.5rem);
    padding: 1rem 1.8rem; border-radius: 14px; text-align: center;
    box-shadow: 6px 6px 0 oklch(0.45 0.06 95);
    animation: sticker-in 0.4s var(--ease-pop) forwards;
    z-index: 55;
  }
</style>
<script>
  import { dotfield } from '../scripts/dotfield';

  // el toggle conserva la sección visible: anexa el hash actual al href
  const sw = document.querySelector('[data-lang-switch]') as HTMLAnchorElement | null;
  if (sw) sw.addEventListener('click', () => { if (location.hash) sw.href = sw.href.split('#')[0] + location.hash; });

  // easter egg v2 "derrumbe y renacer": 3 quick clicks on the logo collapses
  // the whole page into a pile below the viewport, the dot field spells out
  // "kevindlv", then every piece flies back to its exact spot in reverse.
  const CLICK_WINDOW_MS = 1200;
  const MAX_PIECES = 80;
  const HOLD_MS = 900;
  const FALL_EASING = 'cubic-bezier(0.5, 0, 0.9, 0.4)'; // gravity ease-in
  const PIECE_SELECTOR =
    '.logo, nav > a, .avail, #headline .word, .squiggle, .hero .intro, .cta-row .btn, ' +
    '.float, .sticker, .sec-head h2, .sec-head .meta, .step, .xp-row, .about-photo, ' +
    '.about-grid p, .proj-info, .proj-shot, .mail, .socials a, .marquee, footer .foot span';

  const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

  function inViewport(el: Element): boolean {
    const r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0 && r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth;
  }

  interface Piece { el: HTMLElement; anim: Animation; end: number }

  function collectPieces(): Piece[] {
    let els = [...document.querySelectorAll<HTMLElement>(PIECE_SELECTOR)].filter(inViewport);
    if (els.length > MAX_PIECES) {
      els = els
        .map((el) => {
          const r = el.getBoundingClientRect();
          return { el, area: r.width * r.height };
        })
        .sort((a, b) => b.area - a.area)
        .slice(0, MAX_PIECES)
        .map((x) => x.el);
    }
    return els.map((el) => {
      const rect = el.getBoundingClientRect();
      const duration = 900 + Math.random() * 500; // 900-1400ms
      const delay = Math.random() * 350; // 0-350ms
      // land on the viewport floor (pieces stay put and visible, don't fall
      // offscreen): translate just enough so the bottom edge reaches the
      // floor, minus 0-70px so pieces settle at slightly different heights
      // (pile/overlap look). Clamped to 0 so pieces already at/past the
      // floor never get nudged upward.
      const fallY = Math.max(0, (innerHeight - rect.bottom) - Math.random() * 70);
      // rotation scales down with size so nothing large ends up upside down
      // (e.g. the marquee, which falls in the "large" bucket, lands flat)
      const rotRange = rect.width > 560 ? 4 : rect.width > 280 ? 14 : 32;
      const rot = (Math.random() * 2 - 1) * rotRange;
      // single implicit "from" keyframe: WAAPI fills 0% with the element's own
      // underlying (CSS) transform, so reverse() lands it back exactly where
      // it started, whatever that base transform was (e.g. .logo's rotate(-2deg))
      const anim = el.animate(
        [{ transform: `translateY(${fallY}px) rotate(${rot}deg)` }],
        { duration, delay, easing: FALL_EASING, fill: 'forwards' },
      );
      return { el, anim, end: delay + duration };
    });
  }

  let running = false;
  let aborted = false;
  let currentPieces: Piece[] = [];

  function onEscape(e: KeyboardEvent) {
    if (e.key !== 'Escape' || !running) return;
    aborted = true;
    window.removeEventListener('keydown', onEscape);
    currentPieces.forEach((p) => p.anim.cancel());
    void dotfield.clearWord();
    document.documentElement.style.overflow = '';
    currentPieces = [];
    running = false;
  }

  async function runEgg() {
    if (running) return;
    running = true;
    aborted = false;
    document.documentElement.style.overflow = 'hidden';
    window.addEventListener('keydown', onEscape);

    const pieces = collectPieces();
    currentPieces = pieces;
    const collapseMs = pieces.reduce((m, p) => Math.max(m, p.end), 0);
    await sleep(collapseMs);
    if (aborted) return;

    await dotfield.drawWord('kevindlv');
    if (aborted) return;
    await sleep(HOLD_MS);
    if (aborted) return;

    const clearing = dotfield.clearWord();
    pieces.forEach((p) => p.anim.reverse());
    await Promise.all([clearing, ...pieces.map((p) => p.anim.finished.catch(() => {}))]);
    if (aborted) return;

    pieces.forEach((p) => p.anim.cancel());
    window.removeEventListener('keydown', onEscape);
    document.documentElement.style.overflow = '';
    currentPieces = [];
    running = false;
  }

  function showReducedMsg(message: string) {
    if (running) return;
    running = true;
    const msgEl = document.createElement('div');
    msgEl.className = 'egg-msg';
    msgEl.setAttribute('aria-hidden', 'true');
    msgEl.textContent = message;
    document.body.appendChild(msgEl);
    setTimeout(() => {
      msgEl.remove();
      running = false;
    }, 2500);
  }

  const logo = document.querySelector('.logo') as HTMLAnchorElement | null;

  function triggerEgg() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      showReducedMsg(logo?.dataset.eggMsg || '');
    } else {
      void runEgg();
    }
  }

  if (logo) {
    let clickTimes: number[] = [];
    logo.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (running) return;
      const now = Date.now();
      clickTimes = clickTimes.filter((t) => now - t < CLICK_WINDOW_MS);
      clickTimes.push(now);
      if (clickTimes.length >= 3) {
        clickTimes = [];
        triggerEgg();
      }
    });
  }
</script>
